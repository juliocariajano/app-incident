{
  "name": "app-incidents",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "express": "^4",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "watch-incidents": "cds watch --open ns.incidents/index.html?sap-ui-xx-viewCache=false --livereload false",
    "test": "npx jest tests/test.js"
  },
  "cds": {
    "requires": {
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "julio": {
              "roles": [
                "support"
              ]
            },
            "andres": {
              "roles": [
                "support"
              ]
            }
          }
        }
      },
      "[production]": {
        "db": {
          "kind": "hana-cloud"
        },
        "auth": "xsuaa"
      },
      "db": {
        "kind": "sql"
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true
    },
    "build": {
      "target": "gen"
    }
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/incidents"
  ]
}
